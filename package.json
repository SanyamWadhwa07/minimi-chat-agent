{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A chat agent with one tool, web search, that remembers what you asked and when.",
  "license": "MIT",
  "author": "Sanyam Wadhwa",
  "repository": {
    "type": "git",
    "url": "https://github.com/SanyamWadhwa07/minimi-chat-agent.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node scripts/preflight.mjs",
    "dev": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --disable-warning=ExperimentalWarning scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "eval": "tsx --disable-warning=ExperimentalWarning scripts/eval.ts"
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
