# Copy this file to .env and fill in the keys. All three have free tiers, no card needed.
#   cp .env.example .env

# --- Model (at least one of the two; with both, Gemini answers and Groq takes over if it fails) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# --- Web search (required): the agent's one tool ---
# Tavily: https://app.tavily.com  (free: 1,000 searches a month)
TAVILY_API_KEY=

# --- Optional overrides ---
# Writes every answer that uses search results (reasoning: low)
# GEMINI_MODEL=gemini-3.8-flash
# Decides what to search, and answers small talk directly (reasoning: minimal)
# GEMINI_FAST_MODEL=gemini-3.6-flash
# GROQ_MODEL=qwen/qwen3.8-27b
# PORT=3000
